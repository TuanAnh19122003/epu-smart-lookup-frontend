"use client";

import { useEffect, useState } from "react";
import { Meilisearch } from "meilisearch";
import { ChevronDown, Loader2, AlertCircle, Search, ShieldCheck } from "lucide-react";
import Image from "next/image";
import { useRouter } from "next/navigation";

// Biến môi trường
const API_CONFIG_URL =
  process.env.NEXT_PUBLIC_API_CONFIG_URL || "tu_lam_ban_dau_config.json";
const DEFAULT_INDEX_NAME =
  process.env.NEXT_PUBLIC_DEFAULT_INDEX_NAME || "epu_smart_lookup";

interface Student {
  id: string;
  student_code: string;
  full_name: string;
  class_name: string;
  major_name?: string;
  faculty_name?: string;
  avatar_url?: string;
  date_of_birth?: string;
  academic_year?: string;
  status?: string;
}

// Sub-component Avatar với xử lý Error Fallback
function StudentAvatar({
  avatarUrl,
  fullName,
  getInitials,
}: {
  avatarUrl?: string;
  fullName: string;
  getInitials: (name?: string) => string;
}) {
  const [imgError, setImgError] = useState(false);

  if (!avatarUrl || imgError) {
    return (
                              <div className="w-9 h-9 rounded-full text-white font-bold text-xs flex items-center justify-center shrink-0 shadow-sm uppercase select-none" style={{backgroundColor: colors.primary}}>
        {getInitials(fullName)}
      </div>
    );
  }

  return (
    <div className="relative w-9 h-9 rounded-full overflow-hidden shrink-0 border border-slate-200 dark:border-slate-600">
      <Image
        src={avatarUrl}
        alt={fullName}
        fill
        className="object-cover"
        sizes="36px"
        onError={() => setImgError(true)}
      />
    </div>
  );
}

// Sub-component Skeleton Loading
function StudentSkeleton() {
  return (
    <div className="bg-white dark:bg-slate-800/80 rounded-lg p-3 border border-slate-200 dark:border-slate-700/60 shadow-sm animate-pulse">
      <div className="flex items-center justify-between gap-2.5">
        <div className="flex items-center gap-2.5 flex-1">
          {/* Skeleton Circle Avatar */}
          <div className="w-9 h-9 rounded-full bg-slate-200 dark:bg-slate-700 shrink-0" />
          {/* Skeleton Lines Name & Code */}
          <div className="space-y-1.5 flex-1">
            <div className="h-3.5 bg-slate-200 dark:bg-slate-700 rounded w-2/3" />
            <div className="h-2.5 bg-slate-100 dark:bg-slate-800 rounded w-1/3" />
          </div>
        </div>
        {/* Skeleton Button Detail */}
        <div className="h-3 bg-slate-200 dark:bg-slate-700 rounded w-12" />
      </div>
    </div>
  );
}

export default function Home() {
  const [query, setQuery] = useState("");
  const [results, setResults] = useState<Student[]>([]);
  const [loading, setLoading] = useState(false);
  const [client, setClient] = useState<Meilisearch | null>(null);
  const [indexName, setIndexName] = useState<string>(DEFAULT_INDEX_NAME);
  const [error, setError] = useState<string | null>(null);
  const [expandedStudentId, setExpandedStudentId] = useState<string | null>(null);
  const router = useRouter();
  
  // Meta Design System Colors
  const colors = {
    primary: "#0064e0",
    primaryDeep: "#0457cb",
    primarySoft: "#0091ff",
    canvas: "#ffffff",
    surfaceSoft: "#f1f4f7",
    inkDeep: "#0a1317",
    ink: "#1c1e21",
    charcoal: "#444950",
    steel: "#5d6c7b",
    stone: "#8595a4",
    hairlineSoft: "#dee3e9",
    success: "#31a24c",
    critical: "#e41e3f",
  };

  // Khởi tạo Meilisearch từ Backend
  useEffect(() => {
    async function initMeilisearch() {
      try {
        const res = await fetch(API_CONFIG_URL);
        if (!res.ok) throw new Error(`Lỗi kết nối API Config (${res.status})`);

        const data = await res.json();
        const host = data.host;
        const apiKey = data.searchKey;
        const targetIndex = data.indexName || DEFAULT_INDEX_NAME;

        if (!host || !apiKey) {
          throw new Error("Dữ liệu cấu hình API trả về không đầy đủ.");
        }

        const msClient = new Meilisearch({ host, apiKey });
        setClient(msClient);
        setIndexName(targetIndex);
      } catch (err: any) {
        console.error(err);
        setError("Không thể khởi tạo cấu hình tra cứu.");
      }
    }

    initMeilisearch();
  }, []);

  // Xử lý truy vấn tìm kiếm với debounce (300ms) tránh call API liên tục
  useEffect(() => {
    if (!query.trim()) {
      setResults([]);
      setLoading(false);
      return;
    }

    if (!client) return;

    // Bật trạng thái loading ngay khi người dùng bắt đầu nhập (trước khi hết thời gian debounce)
    setLoading(true);

    const handler = setTimeout(async () => {
      try {
        const index = client.index(indexName);
        const searchRes = await index.search(query, { limit: 30 });
        setResults(searchRes.hits as Student[]);
      } catch (err) {
        console.error("Lỗi truy vấn:", err);
      } finally {
        setLoading(false);
      }
    }, 300); // Debounce time 300ms tối ưu trải nghiệm gõ phím

    // Hủy timeout cũ nếu người dùng tiếp tục nhập ký tự mới trước 300ms
    return () => {
      clearTimeout(handler);
    };
  }, [query, client, indexName]);

  const getInitials = (fullName?: string) => {
    if (!fullName) return "SV";
    const words = fullName.trim().split(/\s+/);
    if (words.length === 1) return words[0].substring(0, 2).toUpperCase();
    const firstInitial = words[0].charAt(0);
    const lastInitial = words[words.length - 1].charAt(0);
    return `${lastInitial}${firstInitial}`.toUpperCase();
  };

  const toggleExpand = (id: string) => {
    setExpandedStudentId(expandedStudentId === id ? null : id);
  };

  return (
    <main className="min-h-screen bg-white flex flex-col justify-between p-4 sm:p-6" style={{backgroundColor: colors.canvas}}>
      {/* Spacer đỉnh giúp đẩy Card lên trên */}
      <div className="pt-2 sm:pt-6 flex-1 flex items-center justify-center">
        {/* Container chính */}
        <div className="w-full max-w-4xl rounded-3xl shadow-lg overflow-hidden grid grid-cols-1 md:grid-cols-12 min-h-110 border" style={{backgroundColor: colors.canvas, borderColor: colors.hairlineSoft, boxShadow: "rgba(20, 22, 26, 0.3) 0px 1px 4px 0px"}}>

          {/* ================= CỘT TRÁI (KẾT QUẢ / BANNER) ================= */}
          <div className="md:col-span-6 lg:col-span-7 flex flex-col justify-between relative overflow-hidden" style={{backgroundColor: colors.surfaceSoft, borderRight: `1px solid ${colors.hairlineSoft}`}}>

            {query.trim() === "" ? (
              /* TRẠNG THÁI CHƯA TÌM KIẾM: Banner Logo */
              <div className="w-full h-full min-h-65 md:min-h-full relative flex items-center justify-center overflow-hidden">
                <Image
                  src="/logo-left.svg"
                  alt="EPU Logo"
                  fill
                  className="object-cover"
                  priority
                />
              </div>
            ) : (
              /* TRẠNG THÁI ĐÃ TÌM KIẾM: Danh sách kết quả */
              <div className="p-4 sm:p-5 flex-1 flex flex-col h-full max-h-120">
                <h2 className="text-sm font-bold mb-3 flex items-center justify-between" style={{color: colors.inkDeep}}>
                  <span>
                    {loading
                      ? "Đang tìm kiếm..."
                      : `Sinh viên (${results.length})`}
                  </span>
                  {loading && (
                    <Loader2 className="w-3.5 h-3.5 animate-spin" style={{color: colors.primary}} />
                  )}
                </h2>

                <div className="flex-1 overflow-y-auto pr-1 space-y-2.5 custom-scrollbar" style={{scrollbarColor: colors.hairlineSoft + ' transparent'}}>
                  {/* TRẠNG THÁI LOADING: Hiển thị Skeleton */}
                  {loading ? (
                    <>
                      <StudentSkeleton />
                      <StudentSkeleton />
                      <StudentSkeleton />
                      <StudentSkeleton />
                    </>
                  ) : results.length > 0 ? (
                    /* CÓ KẾT QUẢ */
                    results.map((student) => {
                      const isExpanded =
                        expandedStudentId ===
                        (student.id || student.student_code);
                      return (
                        <div
                          key={student.id || student.student_code}
                          className="rounded-2xl p-3 border transition-all hover:shadow-sm"
                          style={{backgroundColor: colors.canvas, borderColor: colors.hairlineSoft}}
                        >
                          <div className="flex items-center justify-between gap-2.5">
                            <div className="flex items-center gap-2.5">
                              <StudentAvatar
                                avatarUrl={student.avatar_url}
                                fullName={student.full_name}
                                getInitials={getInitials}
                              />

                              <div>
                                <h3 className="font-bold text-sm leading-snug" style={{color: colors.ink}}>
                                  {student.full_name}
                                </h3>
                                <p className="text-[11px] font-mono mt-0.5" style={{color: colors.steel}}>
                                  {student.student_code}
                                </p>
                              </div>
                            </div>

                            <button
                              onClick={() => router.push(`/students/${student.student_code}`)}
                              className="text-[11px] font-medium hover:underline flex items-center gap-0.5 transition-colors"
                              style={{color: colors.primary}}
                            >
                              Chi tiết <ChevronDown className="w-3 h-3 -rotate-90" />
                            </button>
                          </div>

                          {isExpanded && (
                            <div className="mt-2.5 pt-2.5 text-[11px] space-y-1 animate-fadeIn" style={{borderTop: `1px solid ${colors.hairlineSoft}`, color: colors.steel}}>
                              <p><span style={{color: colors.stone}}>Lớp:</span> <strong>{student.class_name}</strong></p>
                              {student.major_name && <p><span style={{color: colors.stone}}>Ngành:</span> <strong>{student.major_name}</strong></p>}
                              {student.faculty_name && <p><span style={{color: colors.stone}}>Khoa:</span> <strong>{student.faculty_name}</strong></p>}
                              {student.date_of_birth && <p><span style={{color: colors.stone}}>Ngày sinh:</span> <strong>{student.date_of_birth}</strong></p>}

                              {/* Hiển thị Trạng thái */}
                              {student.status && (
                                <p className="flex items-center gap-1.5 pt-1">
                                  <span style={{color: colors.stone}}>Trạng thái:</span>
                                  {(() => {
                                    const statusLower = student.status.toLowerCase();
                                    if (statusLower === "graduated") {
                                      return (
                                        <span className="px-2 py-0.5 rounded-full text-[10px] font-semibold border" style={{backgroundColor: colors.success + '15', color: colors.success, borderColor: colors.success + '30'}}>
                                          Đã tốt nghiệp
                                        </span>
                                      );
                                    }
                                    if (statusLower === "studying") {
                                      return (
                                        <span className="px-2 py-0.5 rounded-full text-[10px] font-semibold border" style={{backgroundColor: colors.primary + '15', color: colors.primary, borderColor: colors.primary + '35'}}>
                                          Đang học
                                        </span>
                                      );
                                    }
                                    return (
                                      <span className="px-2 py-0.5 rounded-full text-[10px] font-semibold border" style={{backgroundColor: colors.surfaceSoft, color: colors.steel, borderColor: colors.hairlineSoft}}>
                                        {student.status}
                                      </span>
                                    );
                                  })()}
                                </p>
                              )}
                            </div>
                          )}
                        </div>
                      );
                    })
                  ) : (
                    /* KHÔNG CÓ KẾT QUẢ */
                    <div className="text-center py-10 text-xs" style={{color: colors.stone}}>
                      Không tìm thấy sinh viên nào
                    </div>
                  )}
                </div>
              </div>
            )}
          </div>

          {/* ================= CỘT PHẢI (TRA CỨU) ================= */}
          <div className="md:col-span-6 lg:col-span-5 p-6 sm:p-8 flex flex-col justify-center items-center" style={{backgroundColor: colors.canvas}}>
            <div className="w-full space-y-5 my-auto">
              {/* Header */}
              <div className="text-center space-y-1">
                <h1 className="text-2xl font-extrabold tracking-tight" style={{color: colors.primary}}>
                  EPU Smart Lookup
                </h1>
                <p className="text-[11px] italic" style={{color: colors.steel}}>
                  Verify faster — Trust smarter
                </p>
              </div>

              {/* Báo lỗi */}
              {error && (
                <div className="p-2.5 border text-[11px] rounded-lg flex items-center gap-2" style={{backgroundColor: colors.critical + '15', borderColor: colors.critical + '30', color: colors.critical}}>
                  <AlertCircle className="w-3.5 h-3.5 shrink-0" />
                  {error}
                </div>
              )}

              {/* Form Input Tra Cứu */}
              <div className="space-y-2">
                <label className="text-xs font-bold block" style={{color: colors.ink}}>
                  Tra cứu thông tin
                </label>
                <div className="relative">
                  <input
                    type="text"
                    className="w-full pl-3.5 pr-9 py-2.5 border rounded-lg text-xs focus:outline-none focus:ring-2 transition-all shadow-sm"
                    style={{
                      backgroundColor: colors.surfaceSoft,
                      borderColor: colors.hairlineSoft,
                      color: colors.ink,
                      focusOutlineColor: colors.primary,
                      '--tw-ring-color': colors.primary
                    } as any}
                    placeholder="Nhập MSV hoặc tên của sinh viên..."
                    value={query}
                    onChange={(e) => setQuery(e.target.value)}
                    autoFocus
                  />
                  <div className="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none" style={{color: colors.stone}}>
                    {loading ? (
                      <Loader2 className="w-3.5 h-3.5 animate-spin" style={{color: colors.primary}} />
                    ) : (
                      <Search className="w-3.5 h-3.5" />
                    )}
                  </div>
                </div>
              </div>

              {/* Chú thích thông tin */}
              <div className="p-3 rounded-xl border flex items-start gap-2" style={{backgroundColor: colors.surfaceSoft, borderColor: colors.hairlineSoft}}>
                <ShieldCheck className="w-4 h-4 shrink-0 mt-0.5" style={{color: colors.primary}} />
                <p className="text-[11px] leading-relaxed" style={{color: colors.steel}}>
                  Hệ thống tra cứu thông tin sinh viên
                </p>
              </div>
            </div>
          </div>

        </div>
      </div>

      {/* ================= FOOTER ================= */}
      <footer className="mt-6 pt-4 text-center text-[11px] flex flex-col sm:flex-row items-center justify-between gap-2 max-w-4xl mx-auto w-full" style={{borderTop: `1px solid ${colors.hairlineSoft}`, color: colors.stone}}>
        <div>
          © {new Date().getFullYear()} <strong>EPU Smart Lookup</strong>. All rights reserved.
        </div>
        <div className="flex items-center gap-4">
          <a href="#" className="hover:underline transition-colors" style={{color: colors.stone}}>
            Điều khoản sử dụng
          </a>
          <span>•</span>
          <a href="#" className="hover:underline transition-colors" style={{color: colors.stone}}>
            Chính sách bảo mật
          </a>
          <span>•</span>
          <a href="#" className="hover:underline transition-colors" style={{color: colors.stone}}>
            Hỗ trợ
          </a>
        </div>
      </footer>
    </main>
  );
}